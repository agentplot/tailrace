---
// The start page's hero: the name, the tagline, the actions and the
// animated diagram. Every other page with a hero gets Starlight's own.
import Default from '@astrojs/starlight/components/Hero.astro';
import { LinkButton } from '@astrojs/starlight/components';
import Figure from './Figure.astro';
import { heroSvg } from '../diagrams/hero';

const route = Astro.locals.starlightRoute;
const home = route.id === '';
const { data } = route.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

{
  home ? (
    <div class="home-hero">
      <div class="copy">
        <h1 id="_top" data-page-title set:html={title} />
        {tagline && <p class="tagline" set:html={tagline} />}
        <div class="actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
            </LinkButton>
          ))}
        </div>
      </div>
      <Figure wide={heroSvg('wide')} tall={heroSvg('tall')} />
    </div>
  ) : (
    <Default />
  )
}

<style>
  .home-hero {
    display: grid;
    gap: 1rem;
    padding-block: clamp(1.5rem, calc(0.5rem + 5vmin), 4rem) 0;
  }
  .copy {
    display: grid;
    gap: 1.1rem;
    max-width: 46rem;
  }
  h1 {
    font-family: var(--ap-font-display);
    font-size: clamp(var(--sl-text-4xl), calc(1rem + 6vw), 5.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--sl-color-white);
  }
  .tagline {
    font-size: clamp(var(--sl-text-base), calc(0.5rem + 1.4vw), var(--sl-text-xl));
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
  }
</style>
