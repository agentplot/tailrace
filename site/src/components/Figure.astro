---
// One diagram, drawn wide and tall: the wide one where the figure has room,
// the tall one on a phone. Both are inlined so they follow the theme toggle;
// the one not shown is display:none, so neither runs nor reads twice.
interface Props {
  wide: string;
  tall: string;
  frame?: boolean;
}
const { wide, tall, frame = true } = Astro.props;
---

<figure class:list={['hw-figure', 'not-content', { framed: frame }]}>
  <div class="v wide" set:html={wide} />
  <div class="v tall" set:html={tall} />
  {Astro.slots.has('default') && <figcaption><slot /></figcaption>}
</figure>

<style>
  .hw-figure {
    container-type: inline-size;
    margin: 2rem 0;
  }
  .v {
    line-height: 0;
  }
  .v :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .framed .v {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 1.5rem 3rem -1.75rem var(--d-shadow);
  }
  .tall {
    display: none;
  }
  @container (max-width: 34rem) {
    .wide {
      display: none;
    }
    .tall {
      display: block;
    }
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
